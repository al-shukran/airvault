<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The companion talks to the network, and it is the only app that does. It holds no key material. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Camera Cover is a camera app: the viewfinder and the photo and video modes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Key-press haptics in the gate's keyboard. Vibration only, no sound. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name="app.lumio.LumioApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lensly">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lensly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
