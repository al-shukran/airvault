<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The companion talks to the network, and it is the only app that does. It holds no key material. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Camera Cover is a camera app: the viewfinder and the photo and video modes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The vault key needs the screen lock or a strong biometric again after 30 s (see confirmDeviceCredential). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- An arrived send can post a notice, once the owner has allowed notifications. Lumio never asks for the permission itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name="app.lumio.LumioApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lensly">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lensly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            QR Decode Sandbox: every camera frame is decoded here, as in Lensly. An isolated process has no permissions, no app files and
            no Keystore, so a crafted code that breaks the decoder cannot reach the vault.
        -->
        <service
            android:name="app.lensly.core.qr.QrDecodeService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":qrdecode" />
        <!--
            The Receive sheet shares its code as an image. The provider lets the receiving app read that one file, in the cache folder named in
            receive_share_paths, and no other.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.receive"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/receive_share_paths" />
        </provider>
    </application>

</manifest>
