<?xml version="1.0" encoding="utf-8"?>
<!--
  The Lumio mark: the Lumen ring (Phase 2.8 design, section 1.6). A ring open at 1 o'clock, with a solid dot in the gap where the light
  escapes. The glyph is one colour, so the theme tints it: gold on ink in Night, ink on paper in Day (LumioMark applies the tint).
  Geometry, in the 24 x 24 viewport (1 unit = 1 dp). The spinner, the pull-to-refresh indicator and the pairing progress ring reuse
  these numbers in LumenRing, so change them here and there together:
    ring centre        (12, 12)
    ring radius        8 (centre line of the 2.5 dp stroke; outer 9.25, inner 6.75)
    gap start          18 degrees clockwise from 12 o'clock (the arc's end)
    gap end            42 degrees clockwise from 12 o'clock (the arc's start); the gap is centred on 30 degrees, 1 o'clock
    gap ends           butt caps, cut radially
    dot centre         (16, 12 - 4 * sqrt(3)) = (16, 5.0718), on the ring radius at 30 degrees
    dot radius         1.25 (diameter equals the stroke, 2.5)
  Points on the ring: angle a clockwise from 12 o'clock is (12 + 8 sin a, 12 - 8 cos a).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The open ring: from 42 degrees round the long way to 18 degrees. -->
    <path
        android:pathData="M17.353,6.055 A8,8 0 1 1 14.472,4.392"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="butt" />
    <!-- The dot in the gap, centred on the ring radius at 30 degrees. -->
    <path
        android:pathData="M14.75,5.072 A1.25,1.25 0 1 0 17.25,5.072 A1.25,1.25 0 1 0 14.75,5.072 Z"
        android:fillColor="#FF000000" />
</vector>
