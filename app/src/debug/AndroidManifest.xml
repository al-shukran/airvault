<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest: merged into the debug variant only, never into release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            singleTop lets an am start of MainActivity with the debugHidden extra reach a running MainActivity
            through onNewIntent. With the standard launch mode, the platform does not deliver the intent,
            so the debug hook would never run. Debug builds only.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop" />

        <!-- Gate screen harness for on-device checks. Pass the string extra "screen" with value create or unlock. -->
        <activity
            android:name=".ui.gate.GatePreviewActivity"
            android:exported="true"
            android:label="Gate preview"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lensly">
            <intent-filter>
                <action android:name="app.lensly.action.GATE_PREVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Wallet screen harness for on-device checks. Pass the string extra "screen" with one of: start, choice, skip, dice, coins, result, words, confirm, passphrase, restore, name. -->
        <activity
            android:name=".ui.wallet.WalletPreviewActivity"
            android:exported="true"
            android:label="Wallet preview"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lensly">
            <intent-filter>
                <action android:name="app.lensly.action.WALLET_PREVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- QR and signing harness for on-device checks. Pass the string extra "screen": show1, show12, scan, review or refused. -->
        <activity
            android:name=".ui.qr.QrPreviewActivity"
            android:exported="true"
            android:label="QR preview"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lensly">
            <intent-filter>
                <action android:name="app.lensly.action.QR_PREVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
