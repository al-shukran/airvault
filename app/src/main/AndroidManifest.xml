<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline vault: no INTERNET permission is requested on purpose. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Sound for video recording. Asked the first time the owner picks Video; without it the video has no sound. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Key-press haptics (KeyHaptics). Vibration only, no sound. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- androidx.core merges ACCESS_NETWORK_STATE by default; the app never inspects connectivity. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name="app.lensly.app.LenslyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lensly">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lensly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Parser Sandbox: every parser of scanned input runs here. An isolated process has no permissions, no app
            files and no Keystore, so a parser bug cannot reach the vault.
        -->
        <service
            android:name=".core.parse.ParserSandboxService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":parser" />
        <!--
            QR Decode Sandbox: every camera frame is decoded here. As for the Parser Sandbox, an isolated process has no
            permissions, no app files and no Keystore, so a crafted code that breaks the decoder cannot reach the vault.
        -->
        <service
            android:name=".core.qr.QrDecodeService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":qrdecode" />
    </application>

</manifest>
