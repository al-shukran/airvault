.*
!.gitignore
!.github
!.vscode
!.editorconfig

local.properties
**/build/
*.iml
.gradle/
.kotlin/
.idea/

# Throwaway test-wallet backup; never commit
seed.md
*.key

# Registry release signing key and its passphrase (tools/registry-pack/sign-candidate.sh reads them from outside the repo); never commit
registry-release.*
*.passphrase

# Generated screen gallery (tools/gallery/build-gallery.sh)
/out/

# Screen recordings for pull requests: attach them to the pull request, never commit them
*.mp4
*.mov
*.webm

# Python bytecode
__pycache__/
*.pyc
